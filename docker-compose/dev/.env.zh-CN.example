# Proxy，如果你需要的话（比如你使用 GitHub 作为鉴权服务提供商）
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890


# 其他环境变量，视需求而定，可以参照客户端版本的环境变量配置，注意不要有 ACCESS_CODE
# OPENAI_API_KEY=sk-xxxx
# OPENAI_PROXY_URL=https://api.openai.com/v1
# OPENAI_MODEL_LIST=...


# ===================
# ===== 预设配置 =====
# ===================
# 如没有特殊需要不用更改
LOBE_PORT=3210
RUSTFS_PORT=9000

# Postgres 相关，也即 DB 必须的环境变量
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=change_this_password_on_production

# RustFS S3 配置
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=change_this_password_on_production

# RustFS bucket 配置
S3_ENDPOINT=http://localhost:9000
RUSTFS_LOBE_BUCKET=lobe

# ===========================
# == 自部署队列（Rustash）==
# ===========================
# Rustash 是兼容 QStash 的队列（https://github.com/DSH244/rustash）。
# 开发服务器运行在宿主机上，所以队列通过 APP_URL=http://localhost:3210 回调，
# 并在 127.0.0.1:8080 监听。
# QSTASH_PROVIDER=rustash 会注册完整的自部署定时任务集合。
QSTASH_PROVIDER=rustash
QSTASH_URL=http://127.0.0.1:8080
QSTASH_TOKEN=YOUR_QSTASH_TOKEN
QSTASH_CURRENT_SIGNING_KEY=YOUR_QSTASH_CURRENT_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=YOUR_QSTASH_NEXT_SIGNING_KEY
